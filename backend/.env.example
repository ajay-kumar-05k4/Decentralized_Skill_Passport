PORT=5000
NODE_ENV=development

# MongoDB connection string
# Use a local MongoDB instance by default for development; override with Atlas if needed.
MONGO_URI=mongodb://127.0.0.1:27017/digital-skill-passport

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Placeholders for future Blockchain / Web3 layer integration (not used yet)
# BLOCKCHAIN_ENABLED=false
# METAMASK_NETWORK=sepolia
# SMART_CONTRACT_ADDRESS=
# IPFS_PROJECT_ID=
# PINATA_API_KEY=

