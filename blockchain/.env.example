# Only needed if you want to deploy to a public testnet (e.g. Sepolia).
# Copy this file to .env and fill in real values. Never commit your real .env.
# Also run: npm install --save-dev dotenv

# RPC endpoint from a provider like Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of the deployer wallet (use a throwaway/test wallet, never your main one)
PRIVATE_KEY=your-wallet-private-key
